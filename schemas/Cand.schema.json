{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cand",
  "description": "Stage s1->s2",
  "type": "object",
  "required": [
    "plugin",
    "file",
    "line",
    "class"
  ],
  "properties": {
    "plugin": {
      "description": "string"
    },
    "file": {
      "description": "string"
    },
    "line": {
      "description": "integer"
    },
    "class": {
      "description": "string (e.g. missing_return, null_to_s, dangling_local, uninit_read)"
    },
    "tool": {
      "description": "string"
    },
    "entry_point_hint": {
      "description": "string|null"
    }
  }
}
